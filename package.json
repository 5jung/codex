{
  "name": "nursing-room-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "dev:api": "node --env-file=/workspace/.nursing-runtime/server.env --import tsx server/index.ts",
    "db:start": "python scripts/start-db.py",
    "data:import": "python scripts/import-public.py && python scripts/import-busan.py",
    "test:api": "node --env-file=/workspace/.nursing-runtime/server.env --import tsx --test tests-api/*.test.ts",
    "admin": "node --env-file=/workspace/.nursing-runtime/server.env --import tsx server/admin.ts",
    "typecheck:server": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --strict --skipLibCheck --esModuleInterop server/*.ts",
    "test:data": "python -m unittest discover -s tests -p '*_test.py'",
    "db:init": "node --env-file=/workspace/.nursing-runtime/server.env --import tsx server/init.ts",
    "dev:all": "python scripts/start-dev.py"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "mariadb": "^3.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
